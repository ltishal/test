# Выберите одного провайдера. Если заданы YANDEX_API_KEY и YANDEX_FOLDER_ID,
# Yandex AI Studio имеет приоритет над настройками OPENAI_*.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# По умолчанию: gpt://<YANDEX_FOLDER_ID>/deepseek-v4.1-flash
YANDEX_MODEL=

# OpenAI / OpenRouter / другой OpenAI-совместимый API / Ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Защита API и аккаунты. Для публичного сервера задайте длинный случайный секрет.
RPG_ACCESS_TOKEN=
# Необязательный общий код приглашения; оставьте пустым для открытой регистрации.
RPG_REGISTRATION_CODE=
RPG_REGISTRATION_ENABLED=1
# Для локальной разработки с Ollama можно включить 1; НЕ используйте на публичном сервере.
RPG_ALLOW_UNSAFE_LOCAL=0
# Для Railway Volume рекомендуется /data/saves.
RPG_SAVES_DIR=./saves

# Модели вспомогательных задач (необязательно).
RPG_STATE_MODEL=
RPG_SUMMARY_MODEL=
# Старые названия переменных поддерживаются для совместимости.
EXTRACT_MODEL=
SUMMARY_MODEL=

# Производительность и лимиты.
LLM_TIMEOUT=300
LLM_MAX_CONCURRENT=2
LLM_QUEUE_TIMEOUT=120
RPG_CHAT_MAX_TOKENS=700
RPG_MAX_REQUEST_BYTES=4194304
RPG_AI_CALLS_PER_HOUR=180
RPG_AI_GLOBAL_CALLS_PER_HOUR=450
OPENAI_FREQ_PENALTY=0.35
OPENAI_PRES_PENALTY=0.25
WEB_THREADS=8

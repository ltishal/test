# Local: copy to .env. Railway: set each variable in Variables.
OPENAI_API_KEY=YOUR_KEY_HERE
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=qwen/qwen-2.5-72b-instruct
EXTRACT_MODEL=qwen/qwen-2.5-7b-instruct
SUMMARY_MODEL=qwen/qwen-2.5-7b-instruct

# Generate and keep fixed for production: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Set a strong token to unlock /api/diag and /api/admin/usage; unset = disabled.
ADMIN_TOKEN=

# Railway Volume example: SAVES_DIR=/data. DB is in SAVES_DIR by default.
SAVES_DIR=
QUOTA_DB=
FREE_TURNS=40
GLOBAL_DAILY_TURN_LIMIT=500
SUBSCRIPTION_DAILY_TURNS=60
LLM_MAX_CONCURRENT=2
LLM_QUEUE_TIMEOUT=120
LLM_TIMEOUT=300
SUMMARY_MAX_SESSIONS=128
SUMMARY_BATCH_MESSAGES=10
MASTER_MAX_TOKENS=1200
EXTRACT_MAX_TOKENS=1400
SUMMARY_MAX_TOKENS=450
MAX_REQUEST_BYTES=2097152

# USD per 1M tokens: enter real rates for YOUR model/provider (leave blank for unknown).
MODEL_PRICE_INPUT=
MODEL_PRICE_OUTPUT=
EXTRACT_PRICE_INPUT=
EXTRACT_PRICE_OUTPUT=
SUMMARY_PRICE_INPUT=
SUMMARY_PRICE_OUTPUT=
